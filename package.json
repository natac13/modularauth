{
  "name": "modularauth",
  "module": "index.ts",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter=\"./examples/hono-app\" dev",
    "build": "bun run build:packages",
    "build:packages": "bun run --filter=\"./packages/*\" build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && changeset publish",
    "publish:version": "changeset publish"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.0.0",
    "@tsconfig/node22": "22.0.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@changesets/cli": "2.27.10",
    "prettier": "3.4.2",
    "typescript": "5.6.3"
  },
  "private": true
}
